# Server port
PORT=5000

# MongoDB connection string — must point to a replica set or sharded cluster
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stockwise?retryWrites=true&w=majority

# Dedicated test database — required for integration tests
# The database name MUST be stockwise-test. Tests will refuse to run against any other database.
MONGODB_URI_TEST=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/stockwise-test?retryWrites=true&w=majority

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173